# Infura Project ID (required for network connections)
INFURA_PROJECT_ID=your_infura_project_id

# Etherscan API Key (required for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Base Etherscan API Key (required for Base network contract verification)
BASE_ETHERSCAN_API_KEY=your_base_etherscan_api_key

# Wallet configuration (use either MNEMONIC or WALLET_PRIVATE_KEY)
# Default mnemonic for local development
MNEMONIC=test test test test test test test test test test test junk

# Or use a specific private key (optional)
# WALLET_PRIVATE_KEY=your_private_key_here